<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         backupGlobals="true"
         stopOnFailure="false"
         processIsolation="false"
         bootstrap="vendor/autoload.php"
         cacheDirectory="vendor/.cache.phpunit"
         backupStaticProperties="false"
>
    <testsuites>
        <testsuite name="Component Tests">
            <directory>tests</directory>
            <directory>libs/bridge/phpstan/tests</directory>
            <directory>libs/bridge/symfony/tests</directory>
            <directory>libs/component/coercer/tests</directory>
            <directory>libs/component/diagnostics/tests</directory>
            <directory>libs/component/instantiator/tests</directory>
            <directory>libs/component/mapping/tests</directory>
            <directory>libs/component/naming/tests</directory>
            <directory>libs/component/property-accessor/tests</directory>
            <directory>libs/component/type-matcher/tests</directory>
        </testsuite>
    </testsuites>

    <coverage/>

    <source>
        <include>
            <directory suffix=".php">src</directory>
            <directory suffix=".php">libs/bridge/phpstan/src</directory>
            <directory suffix=".php">libs/bridge/symfony/src</directory>
            <directory suffix=".php">libs/component/coercer/src</directory>
            <directory suffix=".php">libs/component/diagnostics/src</directory>
            <directory suffix=".php">libs/component/instantiator/src</directory>
            <directory suffix=".php">libs/component/mapping/src</directory>
            <directory suffix=".php">libs/component/naming/src</directory>
            <directory suffix=".php">libs/component/property-accessor/src</directory>
            <directory suffix=".php">libs/component/type-matcher/src</directory>
        </include>
    </source>

    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="-1"/>
    </php>
</phpunit>
