includes:
  - libs/bridge/phpstan/phpstan.neon
  - libs/component/coercer/phpstan.neon
  - libs/component/diagnostics/phpstan.neon
  - libs/component/instantiator/phpstan.neon
  - libs/component/mapping/phpstan.neon
  - libs/component/naming/phpstan.neon
  - libs/component/property-accessor/phpstan.neon
  - libs/component/type-matcher/phpstan.neon

parameters:
  level: max
  phpVersion:
    min: 80100
    max: 80599
  treatPhpDocTypesAsCertain: false
  fileExtensions:
    - php
  paths:
    - src
